# Session
SESSION_SECRET=your-secret-key-change-in-production

# SMTP Configuration (для отправки email)
# Если не заполнено - ссылки для сброса пароля будут выводиться в консоль

# Gmail пример:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password

# Yandex пример:
# SMTP_HOST=smtp.yandex.ru
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=your-email@yandex.ru
# SMTP_PASS=your-app-password

# Mail.ru пример:
# SMTP_HOST=smtp.mail.ru
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=your-email@mail.ru
# SMTP_PASS=your-app-password

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# App
APP_NAME=СкилУм

# Access control (PRD-13): superadmins, defined ONLY here (comma-separated).
# These accounts get full, exclusive rights computed at runtime; the role is
# never stored in the database and cannot be granted through the UI. Missing
# accounts are auto-provisioned at startup (without stored roles); removing an
# address here ends that account's superadmin privileges after a restart.
SUPERADMIN_EMAILS=

# Encryption (для шифрования email в базе)
ENCRYPTION_PASSWORD=change-this-to-strong-password
ENCRYPTION_SALT=change-this-to-random-salt