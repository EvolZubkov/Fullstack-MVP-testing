# =============================================================================
# Environment secrets — SECRETS ONLY. Template.
#
# The app loads `.env.<NODE_ENV>` then `.env` (see server/config-loader.mjs).
# Copy this file per environment and fill in real values:
#   cp .env.example .env.development   # local dev
#   cp .env.example .env.test          # test instance
#   cp .env.example .env.production    # production
# (These .env.* files are git-ignored.)
#
# Static non-secret settings live in the per-environment config files
# (config/<NODE_ENV>.config.jsonc). Keep only secrets and per-deployment values
# (e.g. superadmin emails) here — config references them via { "env": "VAR" }.
# =============================================================================

# PostgreSQL connection string (contains credentials) — REQUIRED
DATABASE_URL=postgresql://postgres:password@localhost:5432/scorm_db

# Express session signing secret — REQUIRED in production
SESSION_SECRET=your-secret-key-change-in-production

# Email encryption at rest (email column) — REQUIRED in production
ENCRYPTION_PASSWORD=change-this-to-strong-password
ENCRYPTION_SALT=change-this-to-random-salt

# SMTP credentials — optional. Non-secret SMTP settings (host, port, secure,
# from) live in config/config.jsonc. If host/user/pass are not set, email is
# disabled and password-reset links are logged to the server output instead.
SMTP_USER=
SMTP_PASS=

# Superadmin accounts (PRD-13) — comma-separated emails granted full, exclusive
# rights (computed at runtime, never stored in the DB). Per-deployment value,
# referenced from config.access.superadminEmails via { "env": "SUPERADMIN_EMAILS" }.
# Leave empty for none; missing accounts are auto-provisioned at startup.
SUPERADMIN_EMAILS=

# Runtime environment selector (development | production | test). Also selects
# the config variant config/<NODE_ENV>.config.jsonc when present.
NODE_ENV=development
