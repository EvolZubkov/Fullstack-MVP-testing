{
  "id": "default",
  "name": "Стандартный",
  "version": "1.3.0",
  "templateApiVersion": "1.0",
  "description": "Базовый одноколоночный плеер. Используется по умолчанию для обратной совместимости.",
  "params": [
    {
      "key": "primaryColor",
      "type": "color",
      "label": "Цвет кнопок и активных элементов",
      "default": "217 91% 42%",
      "group": "Цвета",
      "section": "branding",
      "description": "Кнопки «Далее» и «Начать», выбранный вариант ответа, пройденные точки прогресса, рамка фокуса."
    },
    {
      "key": "backgroundColor",
      "type": "color",
      "label": "Фон экрана",
      "default": "225 7% 7%",
      "group": "Цвета",
      "section": "branding",
      "description": "Подложка всего экрана — то, что видно под карточками и текстом."
    },
    {
      "key": "foregroundColor",
      "type": "color",
      "label": "Цвет основного текста",
      "default": "0 0% 98%",
      "group": "Цвета",
      "section": "branding",
      "description": "Заголовки, текст вопроса и текст учебных страниц на фоне экрана."
    },
    {
      "key": "cardColor",
      "type": "color",
      "label": "Фон карточки",
      "default": "225 14% 14%",
      "group": "Цвета",
      "section": "branding",
      "description": "Заливка карточек: учебная страница, карточка вопроса, окно подтверждения, итоги."
    },
    {
      "key": "cardBorderColor",
      "type": "color",
      "label": "Граница карточки",
      "default": "0 0% 24%",
      "group": "Цвета",
      "section": "branding",
      "description": "Контур карточек и модальных окон."
    },
    {
      "key": "borderColor",
      "type": "color",
      "label": "Границы элементов",
      "default": "0 0% 22%",
      "group": "Цвета",
      "section": "branding",
      "description": "Рамки вариантов ответа и полей, разделители внутри карточек."
    },
    {
      "key": "mutedColor",
      "type": "color",
      "label": "Фон вспомогательных блоков",
      "default": "225 10% 20%",
      "group": "Цвета",
      "section": "branding",
      "description": "Заливка невыполненных точек прогресса, вставки с пояснением, дорожки шкал."
    },
    {
      "key": "accentColor",
      "type": "color",
      "label": "Подсветка при наведении",
      "default": "225 8% 22%",
      "group": "Цвета",
      "section": "branding",
      "description": "Заливка варианта ответа и ссылки под курсором мыши."
    },
    {
      "key": "fontFamily",
      "type": "select",
      "label": "Шрифт",
      "default": "Inter",
      "group": "Оформление",
      "section": "branding",
      "options": [
        "Inter",
        "Roboto",
        "Arial"
      ],
      "description": "Гарнитура всего текста пакета."
    },
    {
      "key": "logoUrl",
      "type": "image",
      "label": "Логотип",
      "default": null,
      "group": "Оформление",
      "section": "branding",
      "description": "Показывается в шапке экранов старта и итогов."
    },
    {
      "key": "progress.mode",
      "type": "select",
      "label": "Режим прогресса",
      "default": "questions",
      "group": "Навигация",
      "section": "progress",
      "options": [
        "questions",
        "pages",
        "hidden"
      ],
      "optionLabels": {
        "questions": "По вопросам",
        "pages": "По страницам",
        "hidden": "Не показывать"
      },
      "description": "Что считает индикатор в шапке: выданные вопросы, страницы или ничего."
    },
    {
      "key": "showProgressBar",
      "type": "boolean",
      "label": "Показывать прогресс-бар",
      "default": true,
      "group": "Навигация",
      "section": "progress",
      "description": "Полоса заполнения под счётчиком в шапке."
    }
  ],
