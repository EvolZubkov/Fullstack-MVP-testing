{
  "id": "default",
  "name": "Стандартный",
  "version": "1.4.0",
  "templateApiVersion": "1.0",
  "description": "Базовый одноколоночный плеер. Используется по умолчанию для обратной совместимости.",
  "themes": [
    {
      "id": "light",
      "label": "Светлая"
    },
    {
      "id": "dark",
      "label": "Тёмная"
    }
  ],
  "params": [
    {
      "key": "primaryColor",
      "type": "color",
      "label": "Цвет кнопок и активных элементов",
      "default": null,
      "group": "Цвета",
      "section": "branding",
      "description": "Кнопки «Далее» и «Начать», выбранный вариант ответа, пройденные точки прогресса, рамка фокуса."
    },
    {
      "key": "backgroundColor",
      "type": "color",
      "label": "Фон экрана",
      "default": null,
      "group": "Цвета",
      "section": "branding",
      "description": "Подложка всего экрана — то, что видно под карточками и текстом."
    },
    {
      "key": "foregroundColor",
      "type": "color",
      "label": "Цвет основного текста",
      "default": null,
      "group": "Цвета",
      "section": "branding",
      "description": "Заголовки, текст вопроса и текст учебных страниц на фоне экрана."
    },
    {
      "key": "cardColor",
      "type": "color",
      "label": "Фон карточки",
      "default": null,
      "group": "Цвета",
      "section": "branding",
      "description": "Заливка карточек: учебная страница, карточка вопроса, окно подтверждения, итоги."
    },
    {
      "key": "cardBorderColor",
      "type": "color",
      "label": "Граница карточки",
      "default": null,
      "group": "Цвета",
      "section": "branding",
      "description": "Контур карточек и модальных окон."
    },
    {
      "key": "borderColor",
      "type": "color",
      "label": "Границы элементов",
      "default": null,
      "group": "Цвета",
      "section": "branding",
      "description": "Рамки вариантов ответа и полей, разделители внутри карточек."
    },
    {
      "key": "mutedColor",
      "type": "color",
      "label": "Фон вспомогательных блоков",
      "default": null,
      "group": "Цвета",
      "section": "branding",
      "description": "Заливка невыполненных точек прогресса, вставки с пояснением, дорожки шкал."
    },
    {
      "key": "accentColor",
      "type": "color",
      "label": "Подсветка при наведении",
      "default": null,
      "group": "Цвета",
      "section": "branding",
      "description": "Заливка варианта ответа и ссылки под курсором мыши."
    },
    {
      "key": "fontFamily",
      "type": "select",
      "label": "Шрифт",
      "default": "Inter",
      "group": "Оформление",
      "section": "branding",
      "options": [
        "Inter",
        "Roboto",
        "Arial"
      ],
      "description": "Гарнитура всего текста пакета."
    },
    {
      "key": "logoUrl",
      "type": "image",
      "label": "Логотип",
      "default": null,
      "group": "Оформление",
      "section": "branding",
      "description": "Показывается в шапке экранов старта и итогов."
    },
    {
      "key": "progress.mode",
      "type": "select",
      "label": "Режим прогресса",
      "default": "questions",
      "group": "Навигация",
      "section": "progress",
      "options": [
        "questions",
        "pages",
        "hidden"
      ],
      "optionLabels": {
        "questions": "По вопросам",
        "pages": "По страницам",
        "hidden": "Не показывать"
      },
      "description": "Что считает индикатор в шапке: выданные вопросы, страницы или ничего."
    },
    {
      "key": "showProgressBar",
      "type": "boolean",
      "label": "Показывать прогресс-бар",
      "default": true,
      "group": "Навигация",
      "section": "progress",
      "description": "Полоса заполнения под счётчиком в шапке."
    },
    {
      "key": "levelScheme",
      "type": "select",
      "label": "Цветовая схема уровней",
      "default": "traffic",
      "group": "Цвета",
      "section": "branding",
      "options": [
        "traffic",
        "neutral",
        "custom"
      ],
      "optionLabels": {
        "traffic": "Зелёный — жёлтый — красный",
        "neutral": "Нейтральная, оттенки одного цвета",
        "custom": "Своя"
      },
      "description": "Как окрашиваются уровни шкал и показателей. «Своя» задействует три поля цвета ниже."
    },
    {
      "key": "levelColorFavorable",
      "type": "color",
      "cssVar": "--tb-level-favorable",
      "label": "Цвет благоприятного края",
      "default": null,
      "group": "Цвета",
      "section": "branding",
      "description": "Применяется, когда выбрана схема «Своя»."
    },
    {
      "key": "levelColorMid",
      "type": "color",
      "cssVar": "--tb-level-mid",
      "label": "Цвет середины",
      "default": null,
      "group": "Цвета",
      "section": "branding",
      "description": "Необязателен: без него переход идёт напрямую из края в край."
    },
    {
      "key": "levelColorUnfavorable",
      "type": "color",
      "cssVar": "--tb-level-unfavorable",
      "label": "Цвет неблагоприятного края",
      "default": null,
      "group": "Цвета",
      "section": "branding",
      "description": "Применяется, когда выбрана схема «Своя»."
    },
    {
      "key": "scaleRenderKind",
      "type": "select",
      "label": "Вид шкал",
      "default": "band_ruler",
      "group": "Итоги",
      "section": "branding",
      "options": [
        "label",
        "value",
        "value_of_max",
        "ring",
        "band_ruler",
        "gradient_bar"
      ],
      "optionLabels": {
        "label": "Только уровень",
        "value": "Значение",
        "value_of_max": "Значение из максимума",
        "ring": "Кольцо",
        "band_ruler": "Линейка с зонами",
        "gradient_bar": "Полоса-градусник"
      },
      "description": "Применяется там, где выполним; иначе откатывается на ближайший доступный."
    },
    {
      "key": "indicatorRenderKind",
      "type": "select",
      "label": "Вид показателей",
