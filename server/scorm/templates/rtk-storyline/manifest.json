{
  "id": "rtk-storyline",
  "name": "RTK Storyline",
  "version": "1.0.0",
  "templateApiVersion": "1.0",
  "description": "Шаблон для сертификационного теста руководителей в стиле StoryLine-референса. Тексты вопросов, ответов и контентных блоков рендерятся как текст, а не как графические файлы.",
  "designSize": {
    "width": 1280,
    "height": 720
  },
  "layouts": {
    "shell": "shell.html",
    "start": "layouts/start.html",
    "question": "layouts/question.html",
    "question.single": "layouts/question-single.html",
    "question.multiple": "layouts/question-multiple.html",
    "question.matching": "layouts/question-matching.html",
    "question.ranking": "layouts/question-ranking.html",
    "content": "layouts/content.html",
    "content.intro": "layouts/content.html",
    "content.info": "layouts/content.html",
    "content.summary": "layouts/content-summary.html",
    "results": "layouts/results.html",
    "review": "layouts/review.html"
  },
  "systemPages": [
    {
      "id": "system.locked",
      "layout": "layouts/system-locked.html",
      "purpose": "blocking",
      "countInProgress": false,
      "allowNavBack": false
    },
    {
      "id": "system.warning.duplicateTab",
      "layout": "layouts/system-warning.html",
      "purpose": "warning",
      "countInProgress": false,
      "allowNavBack": true
    }
  ],
  "partials": {
    "topicNav": "partials/topic-nav.html",
    "progress": "partials/progress.html",
    "footerActions": "partials/footer-actions.html"
  },
  "contentTemplates": [
    {
      "key": "start.hero",
      "label": "Стартовая: герой с иллюстрацией",
      "pageKind": "start",
      "layout": "start",
      "description": "Первый экран теста с крупным заголовком, вводным текстом и декоративной иллюстрацией.",
      "placeholders": [
        {
          "key": "kicker",
          "type": "text",
          "label": "Надзаголовок",
          "required": false,
          "maxLength": 80,
          "textFit": {
            "mode": "fixed",
            "defaultFontSize": 14,
            "overflow": "warn"
          }
        },
        {
          "key": "titleLine1",
          "type": "text",
          "label": "Заголовок: строка 1",
          "required": false,
          "maxLength": 40,
          "textFit": {
            "mode": "autoFitFont",
            "defaultFontSize": 56,
            "minFontSize": 36,
            "maxFontSize": 56,
            "overflow": "warn"
          }
        },
        {
          "key": "titleLine2",
          "type": "text",
          "label": "Заголовок: строка 2",
          "required": false,
          "maxLength": 40,
          "textFit": {
            "mode": "autoFitFont",
            "defaultFontSize": 56,
            "minFontSize": 36,
            "maxFontSize": 56,
            "overflow": "warn"
          }
        },
        {
          "key": "titleAccent",
          "type": "text",
          "label": "Акцент в заголовке",
          "required": false,
          "maxLength": 24,
          "textFit": {
            "mode": "autoFitFont",
            "defaultFontSize": 56,
            "minFontSize": 36,
            "maxFontSize": 56,
            "overflow": "warn"
          }
        },
        {
          "key": "titleLine3",
          "type": "text",
          "label": "Заголовок: строка 3",
          "required": false,
          "maxLength": 40,
          "textFit": {
            "mode": "autoFitFont",
            "defaultFontSize": 56,
            "minFontSize": 36,
            "maxFontSize": 56,
            "overflow": "warn"
          }
        },
        {
          "key": "subtitle",
          "type": "textarea",
          "label": "Краткое описание",
          "required": false,
          "maxLength": 220,
          "textFit": {
            "mode": "fixed",
            "defaultFontSize": 18,
            "overflow": "warn"
          }
        },
        {
          "key": "body",
          "type": "richText",
          "label": "Основной текст",
          "required": false,
          "textFit": {
            "mode": "growBox",
            "defaultFontSize": 16,
            "maxHeight": 180,
            "overflow": "warn"
          },
          "allowedMarks": [
            "bold",
            "italic",
            "link"
          ],
          "allowedBlocks": [
            "paragraph",
            "bulletedList",
            "numberedList"
          ]
        }
      ]
    },
    {
      "key": "intro.briefing",
      "label": "Введение: краткий брифинг",
      "pageKind": "content.intro",
      "layout": "content.intro",
      "description": "Вводная страница перед блоком вопросов.",
      "placeholders": [
        {
          "key": "kicker",
          "type": "text",
          "label": "Надзаголовок",
          "required": false,
          "maxLength": 80,
          "textFit": {
            "mode": "fixed",
            "defaultFontSize": 14,
            "overflow": "warn"
          }
        },
        {
          "key": "title",
          "type": "text",
          "label": "Заголовок",
          "required": false,
          "maxLength": 90,
          "textFit": {
            "mode": "autoFitFont",
            "defaultFontSize": 40,
            "minFontSize": 28,
            "maxFontSize": 40,
            "overflow": "warn"
          }
        },
        {
          "key": "subtitle",
          "type": "textarea",
          "label": "Вводный текст",
          "required": false,
          "maxLength": 220,
          "textFit": {
            "mode": "fixed",
            "defaultFontSize": 20,
            "overflow": "warn"
          }
        },
        {
          "key": "body",
          "type": "richText",
          "label": "Основной текст",
          "required": false,
          "textFit": {
            "mode": "growBox",
            "defaultFontSize": 18,
            "maxHeight": 260,
            "overflow": "warn"
          },
          "allowedMarks": [
            "bold",
            "italic",
            "link"
          ],
          "allowedBlocks": [
            "paragraph",
            "bulletedList",
            "numberedList"
          ]
        }
      ]
    },
    {
      "key": "info.text",
      "label": "Информация: текстовая страница",
      "pageKind": "content.info",
      "layout": "content.info",
      "description": "Учебная или поясняющая страница с заголовком и текстовым блоком.",
      "placeholders": [
        {
          "key": "kicker",
          "type": "text",
          "label": "Надзаголовок",
          "required": false,
          "maxLength": 80,
          "textFit": {
            "mode": "fixed",
            "defaultFontSize": 14,
            "overflow": "warn"
          }
        },
        {
          "key": "title",
          "type": "text",
          "label": "Заголовок",
          "required": false,
          "maxLength": 90,
          "textFit": {
            "mode": "autoFitFont",
            "defaultFontSize": 40,
            "minFontSize": 28,
            "maxFontSize": 40,
            "overflow": "warn"
          }
        },
        {
          "key": "subtitle",
          "type": "textarea",
          "label": "Вводный текст",
          "required": false,
          "maxLength": 220,
          "textFit": {
            "mode": "fixed",
            "defaultFontSize": 20,
            "overflow": "warn"
          }
        },
        {
          "key": "body",
          "type": "richText",
          "label": "Основной текст",
          "required": false,
          "textFit": {
            "mode": "growBox",
            "defaultFontSize": 18,
            "maxHeight": 260,
            "overflow": "warn"
          },
          "allowedMarks": [
            "bold",
            "italic",
            "link"
          ],
          "allowedBlocks": [
            "paragraph",
            "bulletedList",
            "numberedList"
          ]
        }
      ]
    },
    {
      "key": "summary.topicResult",
      "label": "Итог: результат темы",
      "pageKind": "content.summary",
      "layout": "content.summary",
      "description": "Итоговая страница темы с краткой статистикой и пояснением.",
      "placeholders": [
        {
          "key": "kicker",
          "type": "text",
          "label": "Надзаголовок",
          "required": false,
          "maxLength": 80,
          "textFit": {
            "mode": "fixed",
            "defaultFontSize": 14,
            "overflow": "warn"
          }
        },
        {
          "key": "title",
          "type": "text",
          "label": "Заголовок",
          "required": false,
          "maxLength": 90,
          "textFit": {
            "mode": "autoFitFont",
            "defaultFontSize": 40,
            "minFontSize": 28,
            "maxFontSize": 40,
            "overflow": "warn"
          }
        },
        {
          "key": "statusLabel",
          "type": "text",
          "label": "Статус темы",
          "required": false,
          "maxLength": 40,
          "textFit": {
            "mode": "fixed",
            "defaultFontSize": 22,
            "overflow": "warn"
          }
        },
        {
          "key": "percent",
          "type": "number",
          "label": "Процент правильных ответов",
          "required": false,
          "constraints": {
            "min": 0,
            "max": 100
          }
        },
        {
          "key": "questionCount",
          "type": "number",
          "label": "Количество вопросов",
          "required": false,
          "constraints": {
            "min": 0
          }
        },
        {
          "key": "body",
          "type": "richText",
          "label": "Пояснение",
          "required": false,
          "textFit": {
            "mode": "growBox",
            "defaultFontSize": 18,
            "maxHeight": 220,
            "overflow": "warn"
          },
          "allowedMarks": [
            "bold",
            "italic",
            "link"
          ],
          "allowedBlocks": [
            "paragraph",
            "bulletedList",
            "numberedList"
          ]
        }
      ]
    }
  ],
  "assets": {
    "styles": [
      "styles/base.css",
      "styles/theme.css"
    ],
    "scripts": [
      "scripts/template.js"
    ],
    "images": [
      "assets/images/hero-mountain-back.svg",
      "assets/images/hero-mountain.svg",
      "assets/images/content-cubes.png"
    ],
    "preview": "preview.svg"
  },
  "preview": {
    "demoData": "demo/course.json",
    "defaultRoute": "start",
    "routes": [
      {
        "route": "start",
        "pageId": "demo-start",
        "templateKey": "start.hero",
        "label": "Стартовая: герой с иллюстрацией"
      },
      {
        "route": "content.intro",
        "pageId": "demo-intro",
        "templateKey": "intro.briefing",
        "label": "Введение: краткий брифинг"
      },
      {
        "route": "content.info",
        "pageId": "demo-info",
        "templateKey": "info.text",
        "label": "Информация: текстовая страница"
      },
      {
        "route": "question.single",
        "label": "Вопрос: одиночный выбор"
      },
      {
        "route": "question.multiple",
        "label": "Вопрос: множественный выбор"
      },
      {
        "route": "question.matching",
        "label": "Вопрос: сопоставление"
      },
      {
        "route": "question.ranking",
        "label": "Вопрос: ранжирование"
      },
      {
        "route": "content.summary",
        "pageId": "demo-summary",
        "templateKey": "summary.topicResult",
        "label": "Итог: результат темы"
      },
      {
        "route": "results",
        "label": "Результаты"
      },
      {
        "route": "system.locked",
        "label": "Системная: доступ ограничен"
      }
    ],
    "viewports": [
      "desktop",
      "mobile"
    ]
  },
  "params": [
    {
      "key": "brand.primaryColor",
      "type": "color",
      "label": "Основной цвет",
      "default": "#ff4f12",
      "group": "Бренд",
      "cssVar": "--rtk-accent",
      "validation": {
        "required": true
      },
      "section": "branding"
    },
    {
      "key": "brand.surfaceColor",
      "type": "color",
      "label": "Цвет основного экрана",
      "default": "#101828",
      "group": "Бренд",
      "cssVar": "--rtk-surface",
      "section": "branding"
    },
    {
      "key": "brand.pageBackground",
      "type": "color",
      "label": "Фон плеера",
      "default": "#e2e2e2",
      "group": "Бренд",
      "cssVar": "--rtk-page-bg",
      "section": "branding"
    },
    {
      "key": "layout.panelRadius",
      "type": "number",
      "label": "Скругление основного экрана",
      "default": 12,
      "group": "Макет",
      "cssVar": "--rtk-panel-radius",
      "validation": {
        "min": 0,
        "max": 32
      },
      "section": "layout"
    },
    {
      "key": "layout.heroImage",
      "type": "asset",
      "label": "Передняя иллюстрация титульного экрана",
      "default": "assets/images/hero-mountain.svg",
      "group": "Макет",
      "section": "layout"
    },
    {
      "key": "layout.heroImageBack",
      "type": "asset",
      "label": "Задняя иллюстрация титульного экрана",
      "default": "assets/images/hero-mountain-back.svg",
      "group": "Макет",
      "section": "layout"
    },
    {
      "key": "layout.contentDecoration",
      "type": "asset",
      "label": "Декоративная иллюстрация контентных страниц",
      "default": "assets/images/content-cubes.png",
      "group": "Макет",
      "section": "layout"
    },
    {
      "key": "progress.mode",
      "type": "select",
      "label": "Режим прогресса",
      "options": [
        "questions",
        "pages",
        "hidden"
      ],
      "default": "questions",
      "group": "Навигация",
      "section": "progress"
    },
    {
      "key": "navigation.presentation",
      "type": "select",
      "label": "Навигация",
      "options": [
        "bottom",
        "sidebar"
      ],
      "default": "bottom",
      "group": "Навигация",
      "section": "progress"
    },
    {
      "key": "behavior.duplicateTabWarning",
      "type": "boolean",
      "label": "Предупреждать о нескольких вкладках",
      "default": true,
      "group": "Поведение",
      "section": "branding"
    },
    {
      "key": "behavior.commitOnPageEnter",
      "type": "boolean",
      "label": "SCORM commit при входе на страницу",
      "default": true,
      "group": "Поведение",
      "section": "branding"
    }
  ],
  "capabilities": {
    "navigation": [
      "linear",
      "locked"
    ],
    "sidebar": true,
    "progress": [
      "questions",
      "pages",
      "hidden"
    ],
    "timer": true,
    "contentPages": [
      "start",
      "intro",
      "info",
      "summary",
      "html"
    ],
    "questionTypes": [
      "single",
      "multiple",
      "matching",
      "ranking"
    ],
    "customInteractions": false,
    "runtimeApi": "1.0"
  },
  "rules": {
    "template": "rules/template-rules.json"
  }
}
