{
  "id": "minimal",
  "name": "Минималистичный",
  "version": "1.0.0",
  "templateApiVersion": "1.0",
  "description": "Один макет, минимум элементов оболочки. Фокус на содержании.",
  "params": [
    {
      "key": "primaryColor",
      "type": "color",
      "label": "Основной цвет",
      "default": "221 83% 53%",
      "group": "Цвета",
      "section": "branding"
    },
    {
      "key": "backgroundColor",
      "type": "color",
      "label": "Цвет фона",
      "default": "0 0% 97%",
      "group": "Цвета",
      "section": "branding"
    },
    {
      "key": "foregroundColor",
      "type": "color",
      "label": "Цвет текста",
      "default": "0 0% 9%",
      "group": "Цвета",
      "section": "branding"
    },
    {
      "key": "cardColor",
      "type": "color",
      "label": "Цвет карточек",
      "default": "0 0% 100%",
      "group": "Цвета",
      "section": "branding"
    },
    {
      "key": "cardBorderColor",
      "type": "color",
      "label": "Граница карточек",
      "default": "0 0% 88%",
      "group": "Цвета",
      "section": "branding"
    },
    {
      "key": "fontFamily",
      "type": "select",
      "label": "Шрифт",
      "default": "Inter",
      "group": "Оформление",
      "options": [
        "Inter",
        "Roboto",
        "Arial"
      ],
      "section": "branding"
    },
    {
      "key": "progress.mode",
      "type": "select",
      "label": "Режим прогресса",
      "default": "questions",
      "group": "Навигация",
      "options": [
        "questions",
        "pages",
        "hidden"
      ],
      "section": "progress"
    },
    {
      "key": "showProgressBar",
      "type": "boolean",
      "label": "Показывать прогресс-бар",
      "default": true,
      "group": "Навигация",
      "section": "progress"
    }
  ],
  "contentTemplates": [
    {
      "key": "intro.simple",
      "label": "Введение: простое",
      "kind": "intro",
      "pageKind": "content.intro",
      "placeholders": [
        {
          "key": "title",
          "type": "text",
          "label": "Заголовок",
          "required": false,
          "maxLength": 120,
          "textFit": {
            "mode": "autoFitFont",
            "defaultFontSize": 32,
            "minFontSize": 22,
            "maxFontSize": 32,
            "allowAuthorFontSize": false,
            "overflow": "warn"
          }
        },
        {
          "key": "subtitle",
          "type": "text",
          "label": "Подзаголовок",
          "required": false,
          "maxLength": 250,
          "textFit": {
            "mode": "fixed",
            "defaultFontSize": 18,
            "allowAuthorFontSize": false,
            "overflow": "warn"
          }
        }
      ]
    },
    {
      "key": "info.text",
      "label": "Информация: текст",
      "kind": "info",
      "pageKind": "content.info",
      "placeholders": [
        {
          "key": "title",
          "type": "text",
          "label": "Заголовок",
          "required": false,
          "maxLength": 120,
          "textFit": {
            "mode": "autoFitFont",
            "defaultFontSize": 26,
            "minFontSize": 18,
            "maxFontSize": 26,
            "allowAuthorFontSize": false,
            "overflow": "warn"
          }
        },
        {
          "key": "body",
          "type": "richText",
          "label": "Текст",
          "required": false,
          "textFit": {
            "mode": "growBox",
            "defaultFontSize": 16,
            "overflow": "warn"
          },
          "allowedMarks": [
            "bold",
            "italic",
            "link"
          ],
          "allowedBlocks": [
            "paragraph",
            "bulletedList",
            "numberedList"
          ]
        }
      ]
    },
    {
      "key": "summary.text",
      "label": "Итог: текстовый результат",
      "kind": "summary",
      "pageKind": "content.summary",
      "placeholders": [
        {
          "key": "title",
          "type": "text",
          "label": "Заголовок",
          "required": false,
          "maxLength": 120,
          "textFit": {
            "mode": "fixed",
            "defaultFontSize": 26,
            "allowAuthorFontSize": false,
            "overflow": "warn"
          }
        },
        {
          "key": "result",
          "type": "resultField",
          "label": "Результат",
          "required": false,
          "allowedPaths": [
            "result.scorePercent",
            "progress.question.percent"
          ],
          "defaultPath": "result.scorePercent",
          "allowedRenderers": [
            "core.textMetric"
          ],
          "defaultRenderer": "core.textMetric"
        }
      ]
    }
  ],
  "rendererPlugins": [],
  "layouts": {
    "shell": "shell.html",
    "start": "layouts/start.html",
    "content": "layouts/content.html",
    "question": "layouts/question.html",
    "results": "layouts/results.html",
    "system.blocked": "layouts/system.blocked.html"
  },
  "assets": {
    "styles": [
      "styles/theme.css",
      "styles/base.css"
    ],
    "scripts": [
      "scripts/template.js"
    ],
    "images": [],
    "preview": "preview.svg"
  },
  "capabilities": {
    "navigation": [
      "linear",
      "locked"
    ],
    "sidebar": false,
    "progress": [
      "questions",
      "pages",
      "hidden"
    ],
    "timer": false,
    "contentPages": [
      "start",
      "intro",
      "info",
      "summary",
      "html"
    ],
    "questionTypes": [
      "single",
      "multiple",
      "matching",
      "ranking"
    ],
    "customInteractions": false,
    "runtimeApi": "1.0"
  },
  "preview": {
    "demoData": "demo/course.json",
    "defaultRoute": "start",
    "routes": [
      {
        "route": "start",
        "label": "Старт"
      },
      {
        "route": "content.intro",
        "pageId": "demo-intro",
        "templateKey": "intro.simple",
        "label": "Введение: простое"
      },
      {
        "route": "content.info",
        "pageId": "demo-info",
        "templateKey": "info.text",
        "label": "Информация: текст"
      },
      {
        "route": "question.single",
        "questionId": "demo-single",
        "label": "Вопрос: одиночный выбор"
      },
      {
        "route": "question.multiple",
        "questionId": "demo-multiple",
        "label": "Вопрос: множественный выбор"
      },
      {
        "route": "question.matching",
        "questionId": "demo-matching",
        "label": "Вопрос: сопоставление"
      },
      {
        "route": "question.ranking",
        "questionId": "demo-ranking",
        "label": "Вопрос: ранжирование"
      },
      {
        "route": "content.summary",
        "pageId": "demo-summary",
        "templateKey": "summary.text",
        "label": "Итог: текстовый результат"
      },
      {
        "route": "results",
        "label": "Результаты"
      },
      {
        "route": "system.blocked",
        "label": "Системная: доступ ограничен"
      }
    ]
  }
}
