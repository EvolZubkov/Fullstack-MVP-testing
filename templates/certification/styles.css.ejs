:root {
  --background: <%= params.backgroundColor %>;
  --foreground: <%= params.foregroundColor %>;
  --border: <%= params.borderColor %>;
  --card: <%= params.cardColor %>;
  --card-foreground: <%= params.foregroundColor %>;
  --card-border: <%= params.cardBorderColor %>;
  --primary: <%= params.primaryColor %>;
  --primary-foreground: 0 0% 100%;
  --muted: <%= params.mutedColor %>;
  --muted-foreground: 220 6% 42%;
  --accent: <%= params.accentColor %>;
  --destructive: 353 97% 41%;
  --success: 120 44% 37%;
  --font-sans: '<%= params.fontFamily %>', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  --radius: 12px;
  --shadow: 0px 4px 16px rgba(60, 40, 20, 0.12);
}
