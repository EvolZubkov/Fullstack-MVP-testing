# =============================================================================
# Container .env — SECRETS ONLY (mounted read-only at /app/.env by deploy.sh).
#
# Non-secret settings live in config/*.config.jsonc: config/config.jsonc is baked
# into the image; a per-instance config/production.config.jsonc is deployed to the
# host and mounted read-only (seeded from the baked config — see deploy.sh).
# PORT and NODE_ENV are provided by docker-compose, not by this file.
# =============================================================================

# PostgreSQL connection string (contains credentials)
DATABASE_URL=postgresql://user:password@host:5432/test_builder

# Express session signing secret
SESSION_SECRET=your-secret-key-change-in-production

# Email encryption at rest (email column)
ENCRYPTION_PASSWORD=change-this-to-strong-password
ENCRYPTION_SALT=change-this-to-random-salt

# SMTP credentials — optional. Host/port/secure/from are in the config file.
SMTP_USER=
SMTP_PASS=
