# =============================================================================
# deploy.env.example - Deploy configuration template for test-builder.
# Copy to deploy.env and fill in actual values.
# deploy.env is NOT committed to git.
#
# Read by scripts/deploy/deploy.bat (and its deploy-prod / deploy-test wrappers).
# =============================================================================

# === Server connection ===
# Informational: the target is passed to the scripts as <user@server>.
SERVER_HOST=192.168.1.200
SERVER_USER=vvlad1973

# === Production instance ===
# Project name = container name = image tag = /srv/{app,logs,data}/<name>
PROJECT_NAME=test_builder
# Port published on the host; the app inside the container listens on it too.
EXPOSE_PORT=8081

# === Test instance ===
# Separate container, separate database (cloned from production when missing).
TEST_PROJECT=test_builder_test
TEST_PORT=8082

# === Mirrors ===
# A mirror is a production-shaped instance raised from scratch under its own
# third-level domain: scripts\deploy\deploy-mirror.bat <user@server> <label> <port>.
# Its project name is <PROJECT_NAME>_<label> and its URL https://<label>.<base>.
# Everything left empty here is asked interactively by deploy-mirror.bat.
#
# Base domain the label is prefixed to.
MIRROR_BASE_DOMAIN=edtech-rtk.ru
# Contact address for Let's Encrypt: ACME account registration and expiry notices.
CERTBOT_EMAIL=
# Administrator seeded into the empty database of a new mirror (also becomes a
# configured superadmin of that instance). The password is never stored here — the
# wrapper asks for it, or generates one and prints it once.
MIRROR_ADMIN_EMAIL=
