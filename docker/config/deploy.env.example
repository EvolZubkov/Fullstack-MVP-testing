# =============================================================================
# deploy.env.example - Deploy configuration template for test-builder.
# Copy to deploy.env and fill in actual values.
# deploy.env is NOT committed to git.
# =============================================================================

# === Server connection ===
SERVER_HOST=192.168.1.200
SERVER_USER=vvlad1973

# === Project ===
PROJECT_NAME=test_builder

# === Server paths ===
SRV_APP_BASE=/srv/app
SRV_DATA_BASE=/srv/data

# === Application group (used for directory permissions) ===
DIR_GROUP=botadmins

# === Ports ===
# External port exposed on the host
EXPOSE_PORT=8081
# Port the Express server listens on inside the container (matches PORT in .env)
INTERNAL_PORT=8081

# === Test instance (used by deploy-test.bat) ===
# Name of the test project (separate container, separate DB)
TEST_PROJECT=test_builder_test
# External port for the test instance
TEST_PORT=8082
