{
  // =========================================================================
  // Production environment (NODE_ENV=production). Selected by the loader over
  // config/config.jsonc. Non-secret settings only; secrets are defined in
  // .env.production (or the mounted .env) and referenced via { "env": "VAR" }.
  // See config/config.jsonc for the fully-documented base.
  //
  // In a container this file is NOT baked into the image: the deploy copies it to
  // /srv/app/<project>/config and mounts that directory read-only at /app/config.
  // THIS repo copy is the source of truth — every deploy overwrites the host file
  // with it (keeping a backup). Editing the host copy + `docker compose restart`
  // applies a change immediately, but it lasts only until the next deploy, so any
  // lasting change belongs here.
  //
  // Edit the deployment-specific non-secret values before going live:
  //   server.appUrl        -> the public production URL
  //   server.cookieSecure  -> true only when TLS terminates in front (X-Forwarded-Proto)
  //   email.host / from    -> the production SMTP relay
  //   access.superadminEmails
  // =========================================================================
  "log": {
    // File sink in the logs volume (/app/logs -> /srv/logs/<project>). The app never rotates it:
    // the host's logrotate rule for /srv/logs/<project>/*.log does, with copytruncate (pino keeps
    // the file open).
    "fileName": "./logs/app.log",
    "level": { "common": "info", "console": "info", "file": "info", "objects": {} }
  },
  "server": {
    "port": 5000,
    // Real external URL, as seen by the learner (the reverse proxy in front
    // terminates TLS). Used to build email links. No trailing slash (the loader
    // strips one anyway).
    "appUrl": "https://test.edtech-rtk.ru",
    "appName": "Skill'Ум",
    // Enable only behind a reverse proxy that forwards X-Forwarded-Proto: https.
    "cookieSecure": true
  },
  "database": { "url": { "env": "DATABASE_URL" } },
  "session": { "secret": { "env": "SESSION_SECRET" } },
  "encryption": {
    "password": { "env": "ENCRYPTION_PASSWORD" },
    "salt": { "env": "ENCRYPTION_SALT" }
  },
  "email": {
    "host": "smtp.yandex.ru",
    "port": 465,
    "secure": true,
    // Envelope "from" address. Empty -> falls back to the SMTP user.
    "from": "skillum@yandex.com",
    "auth": {
      "user": { "env": "SMTP_USER" },
      "pass": { "env": "SMTP_PASS" }
    }
  },
  "access": { "superadminEmails": { "env": "SUPERADMIN_EMAILS" } },
  // PRD-54. Импорт выгрузок отчётов LMS.
  "analytics": {
    "lmsImport": {
      // Хранить ли ФИО и организацию участника. true = в базе только псевдоним.
      // Псевдоним считается в любом случае: на нём держится ключ повторной загрузки.
      "anonymizeParticipants": true
    }
  },
  // Пакет SCORM: адрес приёма телеметрии — см. config/config.jsonc.
  "scorm": { "telemetryBaseUrl": "https://test.edtech-rtk.ru" },
  // Operational ceilings — see config/config.jsonc for what each one bounds.
  "limits": { "participantsImportMaxRows": 500, "passwordEmailsPerHour": 3, "shortAnswerMaxLength": 250, "answerCheckBudgetMs": 1000, "answerCheckWarnMs": 200 }
}
