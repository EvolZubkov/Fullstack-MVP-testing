{
  // =========================================================================
  // Production environment (NODE_ENV=production). Selected by the loader over
  // config/config.jsonc. Non-secret settings only; secrets are defined in
  // .env.production (or the mounted .env) and referenced via { "env": "VAR" }.
  // See config/config.jsonc for the fully-documented base.
  //
  // Edit the deployment-specific non-secret values before going live:
  //   server.appUrl        -> the public production URL
  //   server.cookieSecure  -> true only when TLS terminates in front (X-Forwarded-Proto)
  //   email.host / from    -> the production SMTP relay
  //   access.superadminEmails
  // =========================================================================
  "log": {
    "fileName": "",
    "level": { "common": "info", "console": "info", "file": "info", "objects": {} }
  },
  "server": {
    "port": 5000,
    // Set to the real external URL (e.g. https://scilum.example.com).
    "appUrl": "",
    "appName": "СкилУм",
    // Enable only behind a reverse proxy that forwards X-Forwarded-Proto: https.
    "cookieSecure": true
  },
  "database": { "url": { "env": "DATABASE_URL" } },
  "session": { "secret": { "env": "SESSION_SECRET" } },
  "encryption": {
    "password": { "env": "ENCRYPTION_PASSWORD" },
    "salt": { "env": "ENCRYPTION_SALT" }
  },
  "email": {
    "host": "smtp.yandex.ru",
    "port": 465,
    "secure": true,
    // Envelope "from" address. Empty -> falls back to the SMTP user.
    "from": "skillum@yandex.com",
    "auth": {
      "user": { "env": "SMTP_USER" },
      "pass": { "env": "SMTP_PASS" }
    }
  },
  "access": { "superadminEmails": { "env": "SUPERADMIN_EMAILS" } }
}
