{
  // =========================================================================
  // Application configuration — the SINGLE source of configuration.
  //
  // Every setting the application reads lives here. Non-secret values are given
  // literally. Secrets are NOT stored here: a secret is defined in .env and
  // referenced from this file via the { "env": "VAR_NAME" } indirection, which
  // the loader resolves from process.env at startup (see server/config.ts).
  //
  // This file is committed; it must never contain secret values — only
  // { "env": ... } references to them.
  //
  // Loading order (first existing wins), by NODE_ENV then default, under
  // ./config then the working directory:
  //   config/<NODE_ENV>.config.jsonc, <NODE_ENV>.config.jsonc,
  //   config/config.jsonc, config.jsonc
  // CONFIG_FILE overrides the search with an explicit path — and in a deployed
  // container it is the ONLY way to select a non-production file (the built server
  // has NODE_ENV folded to "production"). This directory is NOT part of the image:
  // the deploy copies these files to the host (/srv/app/<project>/config) and
  // mounts them read-only at /app/config, so a settings change is an edit plus a
  // restart, never a rebuild. Every deploy refreshes the host copies from here.
  // =========================================================================

  // Application logging (shape mirrors the reference service). Output is via
  // pino-pretty: a console sink plus an optional file sink. Rotation/retention
  // are the runtime's responsibility (logrotate / container log driver) — the
  // app writes to a fixed file and never rotates it.
  "log": {
    // Optional fixed file for the pino-pretty file sink. Empty -> console only.
    // Example: "./logs/app.log". No app-side rotation.
    "fileName": "",
    "level": {
      // Base level processed by the logger. One of:
      // trace | debug | info | warn | error | fatal | silent.
      // Empty/absent -> "info" in production, "debug" otherwise.
      "common": "",
      // Console (stdout) sink level. Empty -> inherits "common".
      "console": "",
      // File sink level (used only when fileName is set). Empty -> inherits "common".
      "file": "",
      // Per-object (per-subsystem) level overrides, keyed by the source tag passed
      // to logger.* calls: e.g. db, scorm, auth, tests, scorm-telemetry,
      // content-pages, assignments, analytics, heartbeat, audit.
      // Example: { "db": "warn", "scorm": "debug" }. SQL query tracing is simply
      // the db subsystem at trace: { "db": "trace" }.
      "objects": {}
    }
  },

  // HTTP server and application identity.
  "server": {
    // Port the app listens on. In containers the PORT env var (set by
    // docker-compose / the image) takes precedence over this value.
    "port": 5000,
    // Public base URL used to build links in emails and invitations
    // (password reset, group/test assignment). Empty -> http://localhost:<port>
    // (development only). Set to the real external URL in production.
    "appUrl": "",
    // Product name used in email subjects and the default sender name.
    "appName": "Skill'Ум",
    // Emit secure session cookies (requires HTTPS end-to-end). Enable in
    // production only when a reverse proxy forwards X-Forwarded-Proto: https.
    "cookieSecure": false
  },

  // PostgreSQL connection. The connection string is a secret (it embeds
  // credentials) — defined in .env, referenced here.
  "database": {
    "url": { "env": "DATABASE_URL" }
  },

  // Express session signing secret (defined in .env).
  "session": {
    "secret": { "env": "SESSION_SECRET" }
  },

  // Email-at-rest encryption keys (defined in .env). Required in production.
  "encryption": {
    "password": { "env": "ENCRYPTION_PASSWORD" },
    "salt": { "env": "ENCRYPTION_SALT" }
  },

  // Outbound email. host/port/secure/from are non-secret; credentials are
  // referenced from .env. When host/user/pass are not configured, email sending
  // is disabled and password-reset links are logged instead.
  "email": {
    "host": "smtp.yandex.ru",
    "port": 465,
    "secure": true,
    // Envelope "from" address. Empty -> falls back to the SMTP user.
    "from": "skillum@yandex.com",
    "auth": {
      "user": { "env": "SMTP_USER" },
      "pass": { "env": "SMTP_PASS" }
    }
  },

  // Access control (PRD-13). Superadmin emails are a PER-DEPLOYMENT value (each
  // instance has its own master account), so they are sourced from the
  // SUPERADMIN_EMAILS env var (.env) — like other per-instance settings — rather
  // than baked literally into this committed file. Accepts a comma-separated
  // string; leave the env var empty for none. These accounts get full, exclusive
  // rights computed at runtime; the role is never stored in the DB and cannot be
  // granted through the UI. Missing accounts are auto-provisioned at startup;
  // removing an address (and restarting) ends that account's privileges.
  "access": {
    "superadminEmails": { "env": "SUPERADMIN_EMAILS" }
  },

  // PRD-54. Импорт выгрузок отчётов LMS как второго источника аналитики.
  "analytics": {
    "lmsImport": {
      // Хранить ли человекочитаемые поля участника — ФИО и организацию. При true в базу идёт
      // только псевдоним, и отчёт LMS перестаёт быть источником персональных данных.
      //
      // Псевдоним считается ВСЕГДА, при любом значении: на нём держатся ключ повторной загрузки
      // и подсчёт уникальных участников. Параметр решает не то, есть ли псевдоним, а то, лежит
      // ли рядом с ним имя — поэтому переключение не меняет идентичность участника и не рвёт
      // уже накопленные ключи.
      //
      // На живую телеметрию НЕ распространяется: она продолжает хранить ФИО, почту и организацию.
      "anonymizeParticipants": true
    },

    // PRD-56 FR-06d: сколько прохождений должно быть в срезе, чтобы показывать ПРОЦЕНТ.
    // Ниже порога экран говорит «мало данных» и печатает само число прохождений.
    //
    // Причина арифметическая: половина 95-процентного доверительного интервала для доли
    // около половины — ±44 п.п. на пяти прохождениях, ±31 на десяти, ±22 на двадцати.
    // «33 % сдали» на группе из трёх — не статистика, а шум, по которому принимают решения
    // о людях. Порог касается ПОКАЗА, а не расчёта: внутри всё считается как есть.
    "minObservations": 10,

    // PRD-70 §3.2: вопрос теста со случайной выборкой «переэкспонирован», если доля прохождений
    // с ним за окно счётчика выдач не меньше этого множителя × ожидаемой доли (квота раздела /
    // размер пула) — при не менее 10 прохождениях. Больше единицы.
    "overexposureRatio": 1.5
  },

  // PRD-55. Выдача заданий с поправкой на накопленную экспозицию.
  "delivery": {
    // За сколько последних месяцев считается экспозиция задания. Выдачи старше окна в расчёт
    // весов не идут: утечка стареет вместе с потоком обучающихся, и «сброса отсчёта» в продукте
    // поэтому нет.
    //
    // Величина описывает эксплуатацию банка, а не отдельный тест, и одинакова для всей
    // установки. Ноль и отрицательные значения не принимаются — с ними счётчик читался бы
    // пустым, и поправка тихо выключилась бы целиком.
    "exposureWindowMonths": 12
  },

  // Пакет SCORM: настройки установки, общие для всех тестов.
  "scorm": {
    // Базовый адрес, на который пакет с включённой телеметрией отправляет данные
    // (<адрес>/api/scorm-telemetry/...). Адрес запекается в пакет при выгрузке, поэтому
    // это должен быть внешний адрес этой системы, доступный из браузера участника в LMS.
    // Пусто -> берётся server.appUrl. Если пусты оба, выгрузка теста с включённой
    // телеметрией отклоняется: localhost в пакет не запекается.
    // Включает телеметрию сам тест (настройки -> Интеграция), адрес — только здесь.
    "telemetryBaseUrl": ""
  },

  // Operational ceilings. These are not policy decisions — they exist so an
  // installation can tune throughput/abuse limits without a code change. The
  // values below are the ones the code used to hard-code.
  "limits": {
    // Maximum rows accepted from one uploaded workbook (participants import and
    // the user import that shares its reader). A larger book is rejected whole,
    // so raise this only together with the operator's patience for one request.
    "participantsImportMaxRows": 500,
    // Password-setup letters per person per hour. ONE budget shared by password
    // recovery and the "set your password" invitation, so the two paths cannot
    // be combined to exceed it.
    "passwordEmailsPerHour": 3,
    // Сколько символов вмещает короткий ответ (PRD-57 FR-28v). 250 — рекомендация
    // SCORM 2004 для взаимодействия `fill-in`; автор задаёт свой предел внутри этого
    // потолка. Число живёт здесь, а не в коде, потому что поведение WebTutor на этом
    // пределе ещё не измерено: замер поменяет настройку, не трогая заведённые задания.
    "shortAnswerMaxLength": 250,
    "answerCheckBudgetMs": 1000,
    "answerCheckWarnMs": 200
  }
}
