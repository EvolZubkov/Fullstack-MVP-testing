    "reencrypt-emails": "tsx script/reencrypt-emails.ts",
    "changelog": "gen-changelog",
    "test": "vitest run",
    "lint:md": "npx --no-install markdownlint-cli2 \"docs/**/*.md\" \"client/src/**/*.md\" \"docker/*.md\" \"*.md\" \"!CHANGELOG.md\" \"!**/node_modules/**\"",
    "lint:md:fix": "npx --no-install markdownlint-cli2 --fix \"docs/**/*.md\" \"client/src/**/*.md\" \"docker/*.md\" \"*.md\" \"!CHANGELOG.md\" \"!**/node_modules/**\"",
    "check:wireframes:ds": "node scripts/check-wireframes-ds.mjs",
    "scorm:sample": "tsx scripts/generate-sample-scorm.ts",
    "scorm:template": "tsx scripts/generate-template-scorm.ts",
    "scorm:player": "node scripts/scorm-player.mjs",
    "scorm:previews": "node scripts/generate-prd1-template-previews.mjs",
    "test:watch": "vitest",
    "push:upstream": "git push upstream HEAD"
  },
