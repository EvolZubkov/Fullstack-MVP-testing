{
  "name": "skillum",
  "version": "2.9.0-beta",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx ./server/index.ts",
    "build": "npm run scorm:previews && tsx script/build.ts",
    "start": "cross-env NODE_ENV=production node dist/index.cjs",
    "check": "tsc",
    "db:push": "drizzle-kit push",
    "create-admin": "tsx script/create-admin.ts",
    "seed": "tsx script/seed-db.ts",
    "reencrypt-emails": "tsx script/reencrypt-emails.ts",
    "bcrypt:residual": "tsx script/bcrypt-residual.ts",
    "changelog": "gen-changelog",
    "test": "vitest run",
    "test:it": "vitest run --config vitest.it.config.ts",
    "lint:md": "npx --no-install markdownlint-cli2 \"docs/**/*.md\" \"client/src/**/*.md\" \"docker/*.md\" \"*.md\" \"!CHANGELOG.md\" \"!**/node_modules/**\"",
    "lint:md:fix": "npx --no-install markdownlint-cli2 --fix \"docs/**/*.md\" \"client/src/**/*.md\" \"docker/*.md\" \"*.md\" \"!CHANGELOG.md\" \"!**/node_modules/**\"",
    "check:wireframes:ds": "node scripts/check-wireframes-ds.mjs",
    "scorm:sample": "tsx scripts/generate-sample-scorm.ts",
    "scorm:template": "tsx scripts/generate-template-scorm.ts",
    "scorm:player": "node scripts/scorm-player.mjs",
    "scorm:previews": "node scripts/generate-prd1-template-previews.mjs",
    "test:watch": "vitest",
    "push:upstream": "git push upstream HEAD"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^3.10.0",
    "@tanstack/react-query": "^5.101.2",
    "@vvlad1973/crypto": "^2.4.0",
    "@vvlad1973/pino-logger-tree": "^1.1.0",
    "@vvlad1973/utils": "^5.1.1",
    "archiver": "^7.0.1",
    "bcryptjs": "^3.0.3",
    "date-fns": "^3.6.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "jsonc-parser": "^3.3.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.453.0",
    "memorystore": "^1.6.8",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.3",
    "pg": "^8.22.0",
    "pino-pretty": "^13.1.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.81.0",
    "react-is": "^19.2.7",
    "recharts": "^3.9.2",
    "tsx": "^4.23.1",
    "wouter": "^3.10.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/archiver": "^7.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "4.17.21",
    "@types/express-session": "^1.19.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.1.1",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "@vvlad1973/gen-changelog": "^1.1.6",
    "autoprefixer": "^10.5.4",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.1",
    "jsdom": "^29.1.1",
    "markdownlint-cli2": "^0.23.1",
    "postcss": "^8.5.19",
    "supertest": "^7.2.2",
    "typescript": "^6.0.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "optionalDependencies": {
    "bufferutil": "^4.0.8"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.0"
    },
    "uuid": "^11.1.1"
  }
}
