{
  "name": "skillum",
  "version": "2.35.1",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "contributors": [
    "Eugeny Zubkov <evolzubkov@gmail.com>",
    "Vladislav Vnukovskiy <vvlad1973@gmail.com>"
  ],
  "scripts": {
    "predev": "cross-env NODE_ENV=development tsx ./scripts/db/check-migrations.ts",
    "dev": "cross-env NODE_ENV=development tsx ./server/index.ts",
    "build": "npm run scorm:previews && tsx scripts/build/build.ts",
    "start": "cross-env NODE_ENV=production node dist/index.cjs",
    "check": "tsc",
    "db:push": "drizzle-kit push",
    "db:migrate": "drizzle-kit migrate",
    "create-admin": "tsx scripts/db/create-admin.ts",
    "seed": "tsx scripts/db/seed-db.ts",
    "reencrypt-emails": "tsx scripts/db/reencrypt-emails.ts",
    "bcrypt:residual": "tsx scripts/db/bcrypt-residual.ts",
    "exposure:rebuild": "tsx scripts/db/rebuild-exposure.ts",
    "psycho:backfill": "tsx scripts/db/backfill-psycho-hash.ts",
    "psycho:demo": "tsx scripts/db/seed-psychometrics-demo.ts",
    "answers:demo": "tsx scripts/db/seed-answer-types-demo.ts",
    "changelog": "gen-changelog",
    "test": "vitest run",
    "test:cov": "vitest run --coverage.enabled=true",
    "test:it": "vitest run --config vitest.it.config.ts",
    "lint:md": "npx --no-install markdownlint-cli2 \"docs/**/*.md\" \"client/src/**/*.md\" \"docker/*.md\" \"*.md\" \"!CHANGELOG.md\" \"!**/node_modules/**\"",
    "lint:md:fix": "npx --no-install markdownlint-cli2 --fix \"docs/**/*.md\" \"client/src/**/*.md\" \"docker/*.md\" \"*.md\" \"!CHANGELOG.md\" \"!**/node_modules/**\"",
    "check:wireframes:ds": "node scripts/docs/check-wireframes-ds.mjs",
    "check:author-numbers": "node scripts/check/check-author-numbers.mjs",
    "check:guards": "npm run check:author-numbers && npm run check:contrast",
    "check:contrast": "node scripts/check/check-contrast.mjs",
    "check:editor-ui": "node scripts/check/check-editor-conformance.mjs",
    "deps:check": "node scripts/deps/check-allowed.mjs",
    "scorm:sample": "tsx scripts/scorm/generate-sample-scorm.ts",
    "scorm:template": "tsx scripts/scorm/generate-template-scorm.ts",
    "scorm:probe": "tsx scripts/scorm/generate-probe-scorm.ts",
    "scorm:player": "node scripts/scorm/scorm-player.mjs",
    "scorm:previews": "node scripts/docs/generate-prd1-template-previews.mjs",
    "icons:gen": "tsx scripts/build/gen-lucide-icons.ts",
    "test:watch": "vitest",
    "push:upstream": "git push upstream HEAD",
    "docs:pdf": "node scripts/docs/build-docs-pdf.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.9.1",
    "@tanstack/react-query": "^5.104.0",
    "@vvlad1973/crypto": "^2.4.0",
    "@vvlad1973/pino-logger-tree": "^1.1.0",
    "@vvlad1973/utils": "^5.1.1",
    "bcryptjs": "^3.0.3",
    "date-fns": "^3.6.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.3",
    "drizzle-zod": "^0.8.3",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "highlight.js": "^11.12.0",
    "jsonc-parser": "^3.3.1",
    "jszip": "^3.10.2",
    "lucide-react": "^1.48.0",
    "mathjax-full": "^3.2.2",
    "memorystore": "^1.6.8",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.12",
    "pg": "^8.23.0",
    "pino-pretty": "^13.1.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.89.0",
    "react-is": "^19.3.0",
    "recharts": "^3.10.1",
    "wouter": "^3.11.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.4.1",
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "4.17.21",
    "@types/express-session": "^1.19.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.2",
    "@vvlad1973/gen-changelog": "^1.1.6",
    "autoprefixer": "^10.6.1",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1",
    "markdownlint-cli2": "^0.23.3",
    "postcss": "^8.5.28",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "optionalDependencies": {
    "bufferutil": "^4.0.8"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.0"
    },
    "uuid": "^11.1.1",
    "@xmldom/xmldom": "^0.9.12"
  }
}
